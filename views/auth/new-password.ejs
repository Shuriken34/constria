<%- include('../partials/head') %>
<section class="section">
  <div class="container" style="max-width:520px">
    <h1 class="display display-m">Parolă nouă</h1>
    <p class="muted" style="margin:12px 0 24px">Alege o parolă nouă pentru contul <strong><%= user.email %></strong>.</p>
    <% if (error) { %><div class="error-summary" role="alert" tabindex="-1" data-error-summary><h2>Nu am putut salva parola</h2><p style="margin:0"><%= error %></p></div><% } %>
    <form class="stack" method="post" action="/cont/parola-noua" data-loading>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field"><label for="np1">Parola nouă</label><input class="input" id="np1" name="password" type="password" autocomplete="new-password" minlength="8" required aria-describedby="np-help"><p class="help" id="np-help">Minimum 8 caractere.</p></div>
      <div class="field"><label for="np2">Confirmă parola</label><input class="input" id="np2" name="password2" type="password" autocomplete="new-password" required></div>
      <button class="btn btn--lg" type="submit">Salvează parola</button>
    </form>
  </div>
</section>
<%- include('../partials/foot') %>
