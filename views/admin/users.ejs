<%- include('../partials/head') %>
<section class="container" style="padding-block:40px 96px">
  <p class="eyebrow">Administrare</p>
  <h1 class="display display-l" style="margin-top:10px">Utilizatori</h1>
  <%- include('nav') %>
  <form method="get" style="display:flex;gap:8px;margin-bottom:16px;max-width:520px"><label class="sr-only" for="uq">Caută</label><input class="input" id="uq" name="q" value="<%= q %>" placeholder="Nume, email sau firmă"><button class="btn">Caută</button></form>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>ID</th><th>Nume</th><th>Email</th><th>Tip</th><th>Locație</th><th>Anunțuri</th><th>Înscris</th><th>Stare</th><th>Acțiuni</th></tr></thead>
    <tbody>
      <% rows.forEach(function (u) { %>
        <tr>
          <td class="tnum"><%= u.id %></td>
          <td><a href="/vanzator/<%= u.id %>"><%= u.company_name || u.name %></a><% if (u.role === 'admin') { %> <span class="tag tag--plum">admin</span><% } %><% if (u.verified) { %> <span class="tag tag--green">verificat</span><% } %></td>
          <td><%= u.email %></td>
          <td><%= u.account_type === 'firma' ? 'Firmă' : 'Persoană' %></td>
          <td><%= u.city %>, <%= u.county %></td>
          <td class="tnum"><%= u.listing_count %></td>
          <td><%= formatDate(u.created_at) %></td>
          <td><%= u.banned ? 'Suspendat' : 'Activ' %></td>
          <td class="actions">
            <% if (u.id !== user.id) { %>
            <form method="post" action="/admin/utilizatori/<%= u.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn--ghost btn--sm" name="action" value="verifica"><%= u.verified ? 'Anulează verificarea' : 'Verifică' %></button>
              <% if (u.banned) { %><button class="btn btn--sm" name="action" value="reactiveaza">Reactivează</button><% } else { %><button class="btn btn--red btn--sm" name="action" value="suspenda">Suspendă</button><% } %>
            </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
</section>
<%- include('../partials/foot') %>
