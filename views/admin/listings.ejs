<%- include('../partials/head') %>
<section class="container" style="padding-block:40px 96px">
  <p class="eyebrow">Administrare</p>
  <h1 class="display display-l" style="margin-top:10px">Anunțuri</h1>
  <%- include('nav') %>
  <form method="get" style="display:flex;gap:8px;margin-bottom:16px;max-width:520px"><label class="sr-only" for="aq">Caută</label><input class="input" id="aq" name="q" value="<%= q %>" placeholder="Titlul anunțului"><button class="btn">Caută</button></form>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>ID</th><th>Titlu</th><th>Vânzător</th><th>Preț</th><th>Stare</th><th>Vizualizări</th><th>Creat</th><th>Acțiuni</th></tr></thead>
    <tbody>
      <% rows.forEach(function (l) { %>
        <tr>
          <td class="tnum"><%= l.id %></td>
          <td><a href="<%= listingUrl(l) %>"><%= truncate(l.title, 45) %></a><% if (l.featured) { %> <span class="tag tag--red">rec.</span><% } %></td>
          <td><a href="/vanzator/<%= l.user_id %>"><%= l.seller_company || l.seller_name %></a></td>
          <td class="tnum"><%= formatPrice(l) %></td>
          <td><span class="tag<%= l.status === 'blocat' ? ' tag--red' : l.status === 'activ' ? ' tag--green' : '' %>"><%= l.status %></span></td>
          <td class="tnum"><%= l.views %></td>
          <td><%= timeAgo(l.created_at) %></td>
          <td class="actions">
            <form method="post" action="/admin/anunturi/<%= l.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
              <% if (l.status === 'blocat') { %><button class="btn btn--sm" name="action" value="activeaza">Deblochează</button><% } else { %><button class="btn btn--red btn--sm" name="action" value="blocheaza">Blochează</button><% } %>
              <button class="btn btn--ghost btn--sm" name="action" value="promoveaza"><%= l.featured ? 'Scoate rec.' : 'Recomandă' %></button>
            </form>
            <form method="post" action="/admin/anunturi/<%= l.id %>" data-confirm="Ștergi definitiv anunțul #<%= l.id %>?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="icon-btn" name="action" value="sterge" aria-label="Șterge anunțul <%= l.id %>" style="color:var(--red-strong)"><i data-lucide="trash-2"></i></button></form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
</section>
<%- include('../partials/foot') %>
