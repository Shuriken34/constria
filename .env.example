# Copiază acest fișier în .env și completează valorile din Supabase
# (Project Settings → API Keys). Cheia „publishable” este publică prin design;
# nu pune NICIODATĂ cheia secretă (sb_secret_...) aici.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opțional
# PORT=3000
# SITE_URL=https://constria.ro
# SESSION_SECRET=un-sir-lung-si-aleatoriu
